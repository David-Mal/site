---
import { getEntry, render } from 'astro:content';
import { site, skills } from '../../data/site';

interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
const about = await getEntry('pages', 'about');
const { Content } = about ? await render(about) : { Content: null };
const Heading = standalone ? 'h1' : 'h2';
---

<section class="section" id="about">
  <Heading class="label">About</Heading>
  <div>
    <div class="prose">{Content && <Content />}</div>
    <dl class="facts">
      {
        skills.map((s) => (
          <>
            <dt>{s.label}</dt>
            <dd>{s.items}</dd>
          </>
        ))
      }
    </dl>
    <p class="links">
      <a href={site.cv} download>Download CV ↓</a>
      <a href="/cv">Read it here</a>
      <a href="/now">What I'm doing now</a>
    </p>
  </div>
</section>
