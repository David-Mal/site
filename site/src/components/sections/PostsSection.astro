---
import { getCollection } from 'astro:content';
import { formatDate } from '../../data/format';

interface Props {
  standalone?: boolean;
  limit?: number;
}
const { standalone = false, limit } = Astro.props;
const all = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const posts = limit ? all.slice(0, limit) : all;
const Heading = standalone ? 'h1' : 'h2';
---

<section class="section" id="posts">
  <Heading class="label">Posts</Heading>
  <div>
  <div class="rows">
    {
      posts.map((p) => (
        <article class="row">
          <div class="row-hd">
            <a class="t" href={`/posts/${p.id}`}>
              {p.data.title}
            </a>
            <time class="y" datetime={p.data.date.toISOString()}>
              {formatDate(p.data.date)}
            </time>
          </div>
          <p>{p.data.description}</p>
        </article>
      ))
    }
  </div>
  {limit && all.length > limit && <a class="more" href="/posts">All posts →</a>}
  </div>
</section>
