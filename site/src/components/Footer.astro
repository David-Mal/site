---
// Cloudflare sets one of these during the build; locally they are empty.
const sha = (process.env.CF_PAGES_COMMIT_SHA ?? process.env.WORKERS_CI_COMMIT_SHA ?? '').slice(0, 7);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <span>© {year} David Malutan · Cluj-Napoca</span>
  <span>
    v1.0{sha && ` · ${sha}`} · no trackers · <a href="/now">now</a> · <a href="/rss.xml">rss</a>
  </span>
</footer>
