// The desk at night. One hand-written SVG; every object is also a menu item.
import { getCollection } from 'astro:content';
import { bootProgram } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Small seeded random generator so the skyline looks the same on every build.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(11);

// Glass area of the window
const G = { x: 210, y: 70, w: 1180, h: 500 };
const ground = G.y + G.h;

type Light = { x: number; y: number; flicker: boolean };
const buildings: { x: number; w: number; h: number; lights: Light[] }[] = [];
for (let x = G.x; x < G.x + G.w; ) {
  const w = Math.min(Math.round(40 + rnd() * 66), G.x + G.w - x);
  const h = Math.round(46 + rnd() * 150);
  const lights: Light[] = [];
  for (let wy = ground - h + 12; wy < ground - 10; wy += 16) {
    for (let wx = x + 7; wx < x + w - 9; wx += 12) {
      const v = rnd();
      if (v < 0.3) lights.push({ x: wx, y: wy, flicker: v < 0.03 });
    }
  }
  buildings.push({ x, w, h, lights });
  x += w + Math.round(rnd() * 5);
}

const stars = Array.from({ length: 46 }, () => ({
  x: G.x + rnd() * G.w,
  y: G.y + 6 + rnd() * 250,
  r: 0.6 + rnd() * 1.3,
}));

const drops = Array.from({ length: 70 }, () => ({
  x: G.x + 20 + rnd() * (G.w - 20),
  y: G.y + rnd() * (G.h - 60),
  len: 10 + rnd() * 16,
  delay: (rnd() * 1.4).toFixed(2),
}));

const bookColors = ['#b9503a', '#2f6f73', '#c7922f', '#3e4f8a', '#5f8547', '#7f4a73'];
const books = projects.map((p, i) => ({
  slug: p.id,
  title: p.data.title,
  label: p.data.short ?? p.data.title.toUpperCase(),
  y: 690 - 30 * (i + 1),
  x: 1126 + Math.round((rnd() - 0.5) * 26),
  w: 232 + Math.round(rnd() * 34),
  color: bookColors[i % bookColors.length],
}));

// Keyboard keys in front of the monitor
const keys: { x: number; y: number; w: number }[] = [];
for (let row = 0; row < 3; row++) {
  for (let k = 0; k < 14; k++) keys.push({ x: 686 + k * 17.5 + (row % 2) * 6, y: 716 + row * 8, w: 14 });
}
