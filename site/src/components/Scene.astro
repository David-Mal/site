<script>
  const scene = document.querySelector<SVGSVGElement>('#scene');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene) {
    // --- On phones, show the whole desk instead of cropping it to the monitor ---
    const narrow = window.matchMedia('(max-width: 760px)');
    const fit = () => {
      scene.setAttribute('viewBox', narrow.matches ? '180 150 1300 750' : '0 0 1600 900');
      scene.setAttribute('preserveAspectRatio', narrow.matches ? 'xMidYMax meet' : 'xMidYMid slice');
    };
    fit();
    narrow.addEventListener('change', fit);

    // --- VCR clock: visitor's local time ---
    const clock = scene.querySelector('#clock');
    const tick = () => {
      const d = new Date();
      if (clock) clock.textContent = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    };
    tick();
    setInterval(tick, 20_000);

    // --- CRT boot sequence: types and "runs" a program in the toy language ---
    type Line = { text: string; kind: string };
    const lines: Line[] = JSON.parse(scene.dataset.boot ?? '[]');
    const textGroup = scene.querySelector('#crt-text');
    const NS = 'http://www.w3.org/2000/svg';
    const X = 680;
    const Y0 = 400;
    const LH = 17;
    const els = lines.map((l, i) => {
      const t = document.createElementNS(NS, 'text');
      t.setAttribute('x', String(X));
      t.setAttribute('y', String(Y0 + i * LH));
      t.setAttribute('class', l.kind);
      textGroup?.appendChild(t);
      return t;
    });
    const cursor = document.createElementNS(NS, 'rect');
    cursor.setAttribute('width', '8');
    cursor.setAttribute('height', '13');
    cursor.setAttribute('fill', '#ffffff');
    textGroup?.appendChild(cursor);

    const placeCursor = (i: number, chars: number) => {
      cursor.setAttribute('x', String(X + chars * 7.8 + 2));
      cursor.setAttribute('y', String(Y0 + i * LH - 11));
    };

    let typing = false;
    const finish = () => {
      typing = false;
      els.forEach((el, i) => (el.textContent = lines[i].text));
      const last = lines.length - 1;
      placeCursor(last, lines[last]?.text.length ?? 0);
      cursor.classList.add('crt-cursor');
    };

    let seen = false;
    try {
      seen = sessionStorage.getItem('booted') === '1';
      sessionStorage.setItem('booted', '1');
    } catch {}

    if (reduceMotion || seen || !lines.length) {
      finish();
    } else {
      typing = true;
      let i = 0;
      let c = 0;
      const step = () => {
        if (!typing) return;
        const line = lines[i];
        if (line.kind === 'out' || line.kind === 'ready') {
          els[i].textContent = line.text; // output appears all at once
          c = line.text.length;
        } else {
          c++;
          els[i].textContent = line.text.slice(0, c);
        }
        placeCursor(i, c);
        if (c >= line.text.length) {
          i++;
          c = 0;
          if (i >= lines.length) return finish();
          setTimeout(step, lines[i].kind === 'out' ? 380 : 160);
        } else {
          setTimeout(step, 28 + Math.random() * 40);
        }
      };
      setTimeout(step, 600);
    }

    // First click on the monitor while it is still typing only skips the animation.
    scene.querySelector('#crt')?.addEventListener('click', (e) => {
      if (typing) {
        e.preventDefault();
        finish();
      }
    });

    // --- Lamp switches the theme ---
    const lamp = scene.querySelector('#lamp');
    const activate = (el: Element | null, fn: () => void) => {
      el?.addEventListener('click', fn);
      el?.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k === 'Enter' || k === ' ') {
          e.preventDefault();
          fn();
        }
      });
    };
    activate(lamp, () => window.__toggleTheme());

    // --- Paper airplane: flies twice, third click opens the project ---
    const plane = scene.querySelector<SVGGElement>('#plane');
    let throws = 0;
    activate(plane, () => {
      throws++;
      if (throws >= 3 || reduceMotion) {
        location.href = plane?.dataset.href ?? '/#projects';
        return;
      }
      plane?.classList.remove('fly');
      void plane?.getBoundingClientRect();
      plane?.classList.add('fly');
    });
    plane?.addEventListener('animationend', () => plane.classList.remove('fly'));

    // --- Gentle parallax on mouse move ---
    const fine = window.matchMedia('(pointer: fine)').matches;
    if (fine && !reduceMotion) {
      const layers = Array.from(scene.querySelectorAll<SVGGElement>('.layer'));
      let raf = 0;
      scene.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const dx = e.clientX / window.innerWidth - 0.5;
          const dy = e.clientY / window.innerHeight - 0.5;
          layers.forEach((l) => {
            const d = Number(l.dataset.depth ?? 1);
            l.style.transform = `translate(${(-dx * 12 * d).toFixed(2)}px, ${(-dy * 8 * d).toFixed(2)}px)`;
          });
        });
      });
    }
  }
</script>
