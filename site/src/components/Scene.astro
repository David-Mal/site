        <stop offset="0" stop-color="#5b6cf0"></stop>
        <stop offset="1" stop-color="#2a3796"></stop>
      </radialGradient>
      <radialGradient id="crtSpill">
        <stop offset="0" stop-color="#5468ff" stop-opacity="0.32"></stop>
        <stop offset="1" stop-color="#5468ff" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="vignette" cx="0.5" cy="0.45" r="0.75">
        <stop offset="0.55" stop-color="#000" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#000" stop-opacity="0.55"></stop>
      </radialGradient>
      <clipPath id="glass"><rect x={G.x} y={G.y} width={G.w} height={G.h}></rect></clipPath>
      <clipPath id="screenClip"><rect x="664" y="354" width="282" height="206" rx="20"></rect></clipPath>
      <pattern id="scan" width="4" height="3" patternUnits="userSpaceOnUse">
