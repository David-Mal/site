---
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import WorkSection from '../components/sections/WorkSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import PostsSection from '../components/sections/PostsSection.astro';
import OnlineSection from '../components/sections/OnlineSection.astro';
---

<Base hero>
  <Scene />
  <div class="page">
    <AboutSection />
    <WorkSection />
    <ProjectsSection />
    <PostsSection limit={5} />
    <OnlineSection />
  </div>
</Base>
